{
  "name": "Julia",
  "scopeName": "source.julia",
  "type": "tree-sitter",
  "parser": "tree-sitter-julia",
  "injectionNames": ["julia"],
  "fileTypes": ["jl"],
  "firstLineRegex": "^#![ \\t]*(?:(?:[^\\s]+[\\\\/])?(?:julia(?:\\.exe)?)|(?:[^\\s]+[\\\\/])?env(?:\\.exe)?[ \\t]+(?:-S[ \\t]+)?(?:julia(?:\\.exe)?))(?:[ \\t\\r\\n]|$)",
  "comments": {
    "start": "# "
  },
  "treeSitter": {
    // Pin a tag or a full SHA, never a branch. Verify the ref is on the main
    // line before trusting it — `gh api repos/OWNER/REPO/compare/<ref>...HEAD`
    // reporting `diverged` or a nonzero `behind` means it is not.
    "parserSource": "github:tree-sitter/tree-sitter-julia#v0.25.0",
    "wasmBuildTool": "tree-sitter-cli#v0.27.1",
    "grammar": "julia.wasm",
    "tagsQuery": "julia-tags.scm",
    "highlightsQuery": "julia-highlights.scm",
    "injectionsQuery": "julia-injections.scm",
    "localsQuery": "julia-locals.scm",
    "foldsQuery": "julia-folds.scm",
    "indentsQuery": "julia-indents.scm"
  }
}
