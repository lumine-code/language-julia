{
  ".source.julia": {
    "bracket-matcher": {
      "autocompleteCharacters": ["()", "[]", "{}", "\"\"", "''"],
      "autocompleteDisabledCharacters": ["'"]
    },
    "editor": {
      "commentStart": "# ",
      "nonWordCharacters": "/\\()\"':,.;<>~@#$%^&*|+=[]{}`?-…",
      "commentDelimiters": {
        "line": "#",
        "block": ["#=", "=#"]
      }
    }
  }
}
